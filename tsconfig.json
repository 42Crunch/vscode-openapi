{
  "compilerOptions": {
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "module": "commonjs",
    "target": "es2020",
    "outDir": "out",
    "rootDir": "src",
    "lib": ["ES2020"],
    "sourceMap": true,
    "paths": {
      "keyv": ["./node_modules/@types/keyv"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", ".vscode-test"]
}
